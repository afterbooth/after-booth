# .env.example → .env 로 복사해서 사람이 직접 채운다. 에이전트는 .env를 읽거나 쓰지 않는다 (hook으로 차단).
# 이 파일에는 실제 값을 절대 적지 않는다.

# --- Meta Model API ---
# 키는 팀원별 $150 크레딧. 개발·스파이크는 KEY_DEV, 최종 live E2E·데모 녹화는 KEY_DEMO (docs/BUDGET.md)
META_API_KEY=
# Phase 0 스파이크에서 https://dev.meta.ai/docs 와 GET /v1/models 로 확인한 값만 넣는다. 추측 금지
META_BASE_URL=
META_SPARK_MODEL=
META_SAM_MODEL=
META_TRANSCRIBE_MODEL=

# --- AI 호출 모드 ---
# replay(기본, 네트워크·크레딧 0) | record(live 호출 + fixtures 저장) | live
AI_MODE=replay
