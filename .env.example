# .env.example → .env 로 복사해서 사람이 직접 채운다. 에이전트는 .env를 읽거나 쓰지 않는다 (hook으로 차단).
# 이 파일에는 실제 값을 절대 적지 않는다.

# --- Meta Model API ---
# 키는 팀원별 $150 크레딧. 개발·스파이크는 KEY_DEV, 최종 live E2E·데모 녹화는 KEY_DEMO (docs/BUDGET.md)
META_API_KEY=
# 아래 값은 https://dev.meta.ai/docs 에서 확인 (2026-10-30). Phase 0에서 GET /v1/models 로 재확인한다
# 문서의 API 주소는 https://api.meta.ai/v1 이지만, Spring AI가 /v1/chat/completions를 붙이므로 /v1 없이 적는다
META_BASE_URL=https://api.meta.ai
META_SPARK_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# --- AI 호출 모드 ---
# replay(기본, 네트워크·크레딧 0) | record(live 호출 + fixtures 저장) | live
AI_MODE=replay
