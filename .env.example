# Copy .env.example to .env and fill it in by hand. Agents never read or write .env (blocked by a hook).
# Never put real values in this file.

# --- Meta Model API ---
# Each teammate has $150 in credits. Development and spike use key A; final live E2E and demo recording use key B (docs/BUDGET.md)
META_API_KEY=
# Values below checked on https://dev.meta.ai/docs (2026-10-30). Re-checked with GET /v1/models in Phase 0
# The docs give https://api.meta.ai/v1, but Spring AI appends /v1/chat/completions, so leave /v1 off here
META_BASE_URL=https://api.meta.ai
META_SPARK_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# --- AI call mode ---
# replay (default, no network, no credits) | record (live call + save fixtures) | live
AI_MODE=replay
