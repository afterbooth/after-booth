{
  "name": "afterbooth-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:api": "orval --config orval.config.ts",
    "predev": "npm run gen:api",
    "dev": "vite",
    "dev:mock": "npm run gen:api && vite --mode mock",
    "prebuild": "npm run gen:api",
    "build": "tsc -b && vite build",
    "pretest": "npm run gen:api",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "orval": "^8.45.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}